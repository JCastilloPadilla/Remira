{
  "manifest_version": 3,
  "name": "Remira · Análisis local de correos",
  "description": "Lee el mensaje abierto en Gmail, permite revisar el texto y lo analiza con tu modelo local de Remira.",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {
    "default_title": "Analizar con Remira",
    "default_popup": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:8765"
  }
}
